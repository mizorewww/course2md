     #[test]
+    fn test_wrap_line_keeps_cjk_closing_punctuation() {
+        let mut wrapper = build_wrapper();
+        let text = "缺少识别组件 llama.cpp，安装后重新检查。你好（世界）、再见！好的，谢谢。";
+        // From two glyphs per line up: narrower lines must force breaks anywhere.
+        for width in 40..240 {
