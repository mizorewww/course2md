+                .map(|boundary| boundary.ix)
+                .collect();
+            for &ix in &boundaries {
+                let next = text[ix..].chars().next().unwrap();
+                assert!(
+                    !LineWrapper::is_cjk_closing_punctuation(next),
+                    "line starts with {next:?} at width {width}: {boundaries:?}"
+                );
+            }
+        }
+    }
