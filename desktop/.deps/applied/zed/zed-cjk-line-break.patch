     #[test]
+    fn test_wrap_line_keeps_cjk_closing_punctuation() {
+        let mut wrapper = build_wrapper();
+        let text = "缺少识别组件 llama.cpp，安装后重新检查。你好（世界）、再见！好的，谢谢。";
+        // From two glyphs per line up: narrower lines must force breaks anywhere.
+        for width in 40..240 {
+            let boundaries: Vec<_> = wrapper
+                .wrap_line(&[LineFragment::text(text)], px(width as f32))
+                .map(|boundary| boundary.ix)
+                .collect();
+            for &ix in &boundaries {
+                let next = text[ix..].chars().next().unwrap();
+                assert!(
+                    !LineWrapper::is_cjk_closing_punctuation(next),
+                    "line starts with {next:?} at width {width}: {boundaries:?}"
+                );
+            }
+        }
+    }
