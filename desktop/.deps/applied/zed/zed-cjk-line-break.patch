+    #[test]
+    fn test_wrap_line_keeps_glued_text_together() {
+        let mut wrapper = build_wrapper();
+        let glued = "11\u{a0}分\u{a0}39\u{a0}秒";
+        let text =
+            format!("预计剩余 {glued}，数据分块到达，上一块于 1\u{a0}分\u{a0}26\u{a0}秒前到达");
+        let start = text.find(glued).unwrap();
+        let inside = |ix: usize, from: usize, len: usize| ix > from && ix < from + len;
+        let second = text.find("1\u{a0}分\u{a0}26\u{a0}秒").unwrap();
+        // Wide enough for each glued span: lines break around it, never inside.
+        for width in 160..480 {
+            for ix in wrapper
+                .wrap_line(&[LineFragment::text(&text)], px(width as f32))
+                .map(|boundary| boundary.ix)
+            {
+                assert!(
+                    !inside(ix, start, glued.len())
+                        && !inside(ix, second, "1\u{a0}分\u{a0}26\u{a0}秒".len()),
+                    "break inside a glued span at {ix}, width {width}"
+                );
+            }
+        }
+    }
