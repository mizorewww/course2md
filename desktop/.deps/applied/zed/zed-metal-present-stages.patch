+/// Native submission phases. Platform crates can call the scope helper without
+/// forwarding a Cargo feature: its clock and storage compile out in GPUI when
+/// `profiler` is disabled.
+#[doc(hidden)]
+#[derive(Debug, Copy, Clone)]
+pub enum PlatformPresentStage {
+    WindowLock,
+    NextDrawable,
+    Encode,
+    Commit,
+    WaitUntilScheduled,
+    DrawablePresent,
+    SchedulePresent,
+    AutoreleaseDrain,
+}
+
+/// Non-overlapping native timings attached to one existing present event.
+#[cfg(feature = "profiler")]
+#[derive(Debug, Default, Copy, Clone)]
+pub struct PlatformPresentStages {
+    pub window_lock: Duration,
+    pub next_drawable: Duration,
+    pub encode: Duration,
+    pub commit: Duration,
+    pub wait_until_scheduled: Duration,
+    pub drawable_present: Duration,
+    pub schedule_present: Duration,
+    pub autorelease_drain: Duration,
+    pub presents_with_transaction: Option<bool>,
+    pub drawable_available: Option<bool>,
+}
+
+#[cfg(feature = "profiler")]
+impl PlatformPresentStages {
+    pub fn measured_duration(&self) -> Duration {
+        self.window_lock
+            + self.next_drawable
+            + self.encode
+            + self.commit
+            + self.wait_until_scheduled
+            + self.drawable_present
+            + self.schedule_present
+            + self.autorelease_drain
+    }
+}
+
+#[cfg(feature = "profiler")]
+thread_local! {
+    // One fixed-size accumulator on the presenting thread. record_present_at
+    // takes and clears it even when no newly drawn frame is pending.
+    static PLATFORM_PRESENT_STAGES: std::cell::Cell<PlatformPresentStages> =
+        std::cell::Cell::new(PlatformPresentStages::default());
+}
+
+#[doc(hidden)]
+pub struct PlatformPresentStageGuard {
+    #[cfg(feature = "profiler")]
+    stage: PlatformPresentStage,
+    #[cfg(feature = "profiler")]
+    started: Option<Instant>,
+}
+
+/// Measures only while opt-in trace collection is enabled. The non-profiler
+/// implementation has no clock reads, thread-local access, or allocations.
+#[doc(hidden)]
+#[inline]
+pub fn platform_present_stage(stage: PlatformPresentStage) -> PlatformPresentStageGuard {
+    #[cfg(feature = "profiler")]
+    {
+        PlatformPresentStageGuard {
+            stage,
+            started: trace_enabled().then(Instant::now),
+        }
+    }
+    #[cfg(not(feature = "profiler"))]
+    {
+        let _ = stage;
+        PlatformPresentStageGuard {}
+    }
+}
+
+impl Drop for PlatformPresentStageGuard {
+    #[inline]
+    fn drop(&mut self) {
+        #[cfg(feature = "profiler")]
+        if let Some(started) = self.started {
+            let elapsed = started.elapsed();
+            PLATFORM_PRESENT_STAGES.with(|cell| {
+                let mut stages = cell.get();
+                match self.stage {
+                    PlatformPresentStage::WindowLock => stages.window_lock += elapsed,
+                    PlatformPresentStage::NextDrawable => stages.next_drawable += elapsed,
+                    PlatformPresentStage::Encode => stages.encode += elapsed,
+                    PlatformPresentStage::Commit => stages.commit += elapsed,
+                    PlatformPresentStage::WaitUntilScheduled => {
+                        stages.wait_until_scheduled += elapsed
+                    }
+                    PlatformPresentStage::DrawablePresent => stages.drawable_present += elapsed,
+                    PlatformPresentStage::SchedulePresent => stages.schedule_present += elapsed,
+                    PlatformPresentStage::AutoreleaseDrain => stages.autorelease_drain += elapsed,
+                }
+                cell.set(stages);
+            });
+        }
+    }
+}
+
+#[doc(hidden)]
+#[inline]
+pub fn platform_present_transaction(transaction: bool) {
+    #[cfg(feature = "profiler")]
+    if trace_enabled() {
+        PLATFORM_PRESENT_STAGES.with(|cell| {
+            let mut stages = cell.get();
+            stages.presents_with_transaction = Some(transaction);
+            cell.set(stages);
+        });
+    }
+    #[cfg(not(feature = "profiler"))]
+    let _ = transaction;
+}
+
+#[doc(hidden)]
+#[inline]
+pub fn platform_present_drawable(available: bool) {
+    #[cfg(feature = "profiler")]
+    if trace_enabled() {
+        PLATFORM_PRESENT_STAGES.with(|cell| {
+            let mut stages = cell.get();
+            stages.drawable_available = Some(available);
+            cell.set(stages);
+        });
+    }
+    #[cfg(not(feature = "profiler"))]
+    let _ = available;
+}
