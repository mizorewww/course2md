+    fn frame_waker(&self) -> Option<Rc<dyn Fn()>> {
+        let state = Arc::downgrade(&self.0);
+        let (foreground_executor, background_executor, frame_wake, closed) = {
+            let state = self.0.lock();
+            (
+                state.foreground_executor.clone(),
+                state.background_executor.clone(),
+                state.frame_wake.clone(),
+                state.closed.clone(),
+            )
+        };
+        Some(deferred_frame_waker(
+            foreground_executor,
+            background_executor,
+            frame_wake,
+            closed,
+            move || {
+                let Some(state) = state.upgrade() else {
+                    return true;
+                };
+                let view = {
+                    let state = state.lock();
+                    if state.closed.load(Ordering::Acquire) {
+                        return true;
+                    }
+                    // A nested AppKit run loop can temporarily keep a frame
+                    // callback on the stack. Retain demand until it is restored.
+                    if state.request_frame_callback.is_none() {
+                        return false;
+                    }
+                    state.native_view
+                };
+                // Never invalidate in the drawing CA transaction: a spinner
+                // would otherwise draw synchronously without yielding to input.
+                // This delayed fallback also works when occlusion or a missing
+                // display prevents start_display_link from providing a tick.
+                unsafe {
+                    let _: () = msg_send![view.as_ptr(), setNeedsDisplay: YES];
+                }
+                true
+            },
+        ))
     }

