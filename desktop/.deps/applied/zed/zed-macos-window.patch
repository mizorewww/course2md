+    #[test]
+    fn primary_frame_consumes_demand_without_a_fallback_draw() {
+        let mut state = FrameWakeState::default();
+        assert!(state.request(false));
+        let before = state.completed;
+        let now = Instant::now();
+        state.begin_frame();
+        state.finish_frame(now);
+        assert_eq!(state.after_wait(before, now, false), FrameWakeAction::Idle);
+        assert!(!state.pending);
+        assert!(state.request(false), "later demand can start a new task");
+    }
+
+    #[test]
+    fn new_demand_survives_primary_frames_and_a_stopped_source() {
+        let mut state = FrameWakeState::default();
+        assert!(state.request(false));
+        let started = Instant::now();
+        for frame in 0..3 {
+            let period = started + Duration::from_millis(frame * 16);
+            let before = state.completed;
+            state.begin_frame();
+            assert!(!state.request(false));
+            state.finish_frame(period + Duration::from_millis(16));
+            assert_eq!(
+                state.after_wait(before, period + Duration::from_millis(32), false),
+                FrameWakeAction::Wait(Duration::from_millis(16)),
+            );
+            assert!(state.pending);
+        }
+        let before = state.completed;
+        assert_eq!(
+            state.after_wait(before, started + Duration::from_millis(80), false),
+            FrameWakeAction::Invalidate,
+            "fallback resumes 32 ms after the last completed frame",
+        );
+        assert!(!state.after_wake(true));
+    }
