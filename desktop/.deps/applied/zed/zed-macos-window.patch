+/// Pure per-window demand bookkeeping shared by display callbacks and the
+/// delayed fallback. Progress means a completed callback, not a running link.
+const FALLBACK_FRAME_INTERVAL: std::time::Duration = std::time::Duration::from_millis(32);
+
+#[derive(Default)]
+struct FrameWakeState {
+    requested: u64,
+    consumed: u64,
+    completed: u64,
+    completed_at: Option<std::time::Instant>,
+    pending: bool,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum FrameWakeAction {
+    Idle,
+    Wait(std::time::Duration),
+    Invalidate,
+}
+
+impl FrameWakeState {
+    /// Returns whether this request must start a new delayed task.
+    fn request(&mut self, closed: bool) -> bool {
+        if closed {
+            self.pending = false;
+            return false;
+        }
+        self.requested = self.requested.wrapping_add(1);
+        !std::mem::replace(&mut self.pending, true)
+    }
+
+    fn begin_frame(&mut self) {
+        // Requests made by the callback belong to the next frame.
+        self.consumed = self.requested;
+    }
+
+    fn finish_frame(&mut self, at: std::time::Instant) {
+        self.completed = self.completed.wrapping_add(1);
+        self.completed_at = Some(at);
+    }
+
+    fn after_wait(
+        &mut self,
+        completed_before_wait: u64,
+        now: std::time::Instant,
+        closed: bool,
+    ) -> FrameWakeAction {
+        if closed || self.requested == self.consumed {
+            self.pending = false;
+            return FrameWakeAction::Idle;
+        }
+        if self.completed != completed_before_wait {
+            // The primary source made progress. Keep new demand as insurance
+            // if it stops. Anchor the deadline to that completed frame, so a
+            // stopped source costs at most one interval, not two polling waits.
+            let deadline = self
+                .completed_at
+                .expect("completed frames have a completion time")
+                + FALLBACK_FRAME_INTERVAL;
+            let remaining = deadline.saturating_duration_since(now);
+            if !remaining.is_zero() {
+                return FrameWakeAction::Wait(remaining);
+            }
+        }
+        // Release task ownership before AppKit can reenter and request
+        // another frame. That request must be allowed to start a task.
+        self.pending = false;
+        FrameWakeAction::Invalidate
+    }
+
+    /// Returns whether the current task still owns an unavailable wake retry.
+    fn after_wake(&mut self, delivered: bool) -> bool {
+        if delivered || self.pending || self.requested == self.consumed {
+            false
+        } else {
+            self.pending = true;
+            true
+        }
+    }
+}
