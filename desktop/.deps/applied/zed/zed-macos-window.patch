+    #[test]
+    fn reentrant_demand_owns_its_retry_after_either_wake_result() {
+        for delivered in [false, true] {
+            let mut state = FrameWakeState::default();
+            assert!(state.request(false));
+            assert_eq!(
+                state.after_wait(0, Instant::now(), false),
+                FrameWakeAction::Invalidate
