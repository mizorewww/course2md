+/// Coalesce demand onto a later main-thread turn. A working display source
+/// consumes it first; the fallback invalidates only after a wait with no
+/// callback progress. Returning false from `try_wake` retains the retry.
+fn deferred_frame_waker(
+    foreground_executor: ForegroundExecutor,
+    background_executor: BackgroundExecutor,
+    frame_wake: Arc<Mutex<FrameWakeState>>,
+    closed: Arc<AtomicBool>,
+    try_wake: impl Fn() -> bool + 'static,
+) -> Rc<dyn Fn()> {
+    let try_wake = Rc::new(try_wake);
+    Rc::new(move || {
+        let completed_before_wait = {
+            let mut state = frame_wake.lock();
+            if !state.request(closed.load(Ordering::Acquire)) {
+                return;
+            }
+            // Capture during request: an animation can ask for this task while
+            // its current display callback has not finished yet.
+            state.completed
+        };
+        let deadline = background_executor.now() + FALLBACK_FRAME_INTERVAL;
+        let frame_wake = frame_wake.clone();
+        let closed = closed.clone();
+        let try_wake = try_wake.clone();
+        let background_executor = background_executor.clone();
+        foreground_executor
+            .spawn(async move {
+                let mut completed_before_wait = completed_before_wait;
+                let mut delay = deadline.saturating_duration_since(background_executor.now());
+                loop {
+                    background_executor.timer(delay).await;
+                    let action = {
+                        let mut state = frame_wake.lock();
+                        let action = state.after_wait(
+                            completed_before_wait,
+                            background_executor.now(),
+                            closed.load(Ordering::Acquire),
+                        );
+                        completed_before_wait = state.completed;
+                        action
+                    };
+                    match action {
+                        FrameWakeAction::Idle => break,
+                        FrameWakeAction::Wait(remaining) => {
+                            delay = remaining;
+                            continue;
+                        }
+                        FrameWakeAction::Invalidate => {}
+                    }
+                    // No state lock may cross AppKit or a reentrant wake.
+                    let delivered = try_wake();
+                    if !frame_wake.lock().after_wake(delivered) {
+                        break;
+                    }
+                    delay = FALLBACK_FRAME_INTERVAL;
+                }
+            })
+            .detach();
+    })
+}
