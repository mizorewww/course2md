+    #[test]
+    fn semantic_focus_delegate_survives_node_less_editor() {
+        let mut a11y = new_a11y();
+        let frame = NodeId(1);
+        let editor = NodeId(2);
+        let focus_id = FocusId::default();
+        assert!(
+            a11y.nodes
+                .push(frame, accesskit::Node::new(Role::TextInput))
+        );
+        a11y.set_focusable(frame, focus_id);
+        a11y.set_focus(frame);
+        a11y.set_focusable(editor, focus_id);
+        a11y.set_focus(editor);
+        assert_eq!(a11y.nodes.focus, Some(frame));
+        assert_eq!(a11y.focus_ids.get(&frame), Some(&focus_id));
+        assert!(a11y.last_focus_without_node.is_none());
