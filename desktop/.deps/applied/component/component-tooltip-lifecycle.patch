+
+    gpui::actions!(tooltip_lifecycle_test, [TooltipNavigate]);
+
+    struct TooltipProbe;
+
+    impl Render for TooltipProbe {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            div()
+                .w(gpui::px(60.))
+                .h(gpui::px(24.))
+                .debug_selector(|| "managed-tooltip-probe".to_owned())
+        }
+    }
+
+    struct TooltipPage {
+        focus: FocusHandle,
+        navigated: bool,
+    }
+
+    impl Render for TooltipPage {
+        fn render(&mut self, _: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+            use crate::tooltip::ManagedTooltipExt as _;
+            use gpui::StatefulInteractiveElement as _;
+
+            div()
+                .size_full()
+                .key_context("TooltipPage")
+                .track_focus(&self.focus)
+                .on_action(cx.listener(|this, _: &TooltipNavigate, _, cx| {
+                    this.navigated = true;
+                    cx.stop_propagation();
+                    cx.notify();
+                }))
+                .when(!self.navigated, |view| {
+                    view.child(
+                        div()
+                            .id("tooltip-trigger")
+                            .w(gpui::px(160.))
+                            .h(gpui::px(40.))
+                            .debug_selector(|| "tooltip-trigger".to_owned())
+                            .managed_tooltip(|_, cx| cx.new(|_| TooltipProbe).into()),
+                    )
+                })
+                .child(
+                    div()
+                        .w(gpui::px(160.))
+                        .h(gpui::px(40.))
+                        .debug_selector(|| "tooltip-navigation".to_owned())
+                        .on_mouse_down(
+                            gpui::MouseButton::Left,
+                            cx.listener(|this, _, _, cx| {
+                                this.navigated = true;
+                                cx.stop_propagation();
+                                cx.notify();
+                            }),
+                        ),
+                )
+        }
+    }
+
+    fn tooltip_page(
+        cx: &mut TestAppContext,
+    ) -> (Entity<TooltipPage>, &mut gpui::VisualTestContext) {
+        cx.update(crate::init);
+        cx.update(|cx| {
+            cx.bind_keys([KeyBinding::new(
+                "ctrl-n",
+                TooltipNavigate,
+                Some("TooltipPage"),
+            )])
+        });
+        let page = cx.update(|cx| {
+            cx.new(|cx| TooltipPage {
+                focus: cx.focus_handle(),
+                navigated: false,
+            })
+        });
+        let (_, cx) = cx.add_window_view(|window, cx| {
+            let focus = page.read(cx).focus.clone();
+            focus.focus(window, cx);
+            Root::new(page.clone(), window, cx).bordered(false)
+        });
+        (page, cx)
+    }
+
+    fn redraw_tooltip(cx: &mut gpui::VisualTestContext) -> bool {
+        cx.update(|window, cx| window.draw(cx).clear(cx));
+        cx.debug_bounds("managed-tooltip-probe").is_some()
+    }
+
+    fn hover_tooltip(cx: &mut gpui::VisualTestContext) {
+        redraw_tooltip(cx);
+        let trigger = cx.debug_bounds("tooltip-trigger").unwrap();
+        cx.simulate_mouse_move(trigger.center(), None, gpui::Modifiers::default());
+        cx.run_until_parked();
+    }
+
+    fn finish_tooltip_delay(cx: &mut gpui::VisualTestContext) {
+        cx.background_executor
+            .advance_clock(std::time::Duration::from_millis(600));
+        cx.run_until_parked();
+    }
+
+    #[gpui::test]
+    fn sibling_click_dismisses_tooltip_before_trigger_disappears(cx: &mut TestAppContext) {
+        let (page, cx) = tooltip_page(cx);
+        hover_tooltip(cx);
+        finish_tooltip_delay(cx);
+        assert!(redraw_tooltip(cx));
+        let navigation = cx.debug_bounds("tooltip-navigation").unwrap();
+        // Deliberately no preceding mouse move/hover(false), as with native
+        // toolbar navigation that removes the previous page in the same event.
+        cx.simulate_mouse_down(
+            navigation.center(),
+            gpui::MouseButton::Left,
+            gpui::Modifiers::default(),
+        );
+        assert!(page.read_with(cx, |page, _| page.navigated));
+        assert!(!redraw_tooltip(cx));
+
+        // Dismissal does not disable future hover requests.
+        cx.simulate_mouse_up(
+            navigation.center(),
+            gpui::MouseButton::Left,
+            gpui::Modifiers::default(),
+        );
+        cx.update(|_, cx| {
+            page.update(cx, |page, cx| {
+                page.navigated = false;
+                cx.notify();
+            })
+        });
+        cx.simulate_mouse_move(
+            gpui::point(gpui::px(300.), gpui::px(300.)),
+            None,
+            gpui::Modifiers::default(),
+        );
+        hover_tooltip(cx);
+        finish_tooltip_delay(cx);
+        assert!(redraw_tooltip(cx));
+    }
+
+    #[gpui::test]
+    fn handled_navigation_shortcut_dismisses_tooltip(cx: &mut TestAppContext) {
+        let (page, cx) = tooltip_page(cx);
+        hover_tooltip(cx);
+        finish_tooltip_delay(cx);
+        assert!(redraw_tooltip(cx));
+        cx.simulate_keystrokes("ctrl-n");
+        assert!(page.read_with(cx, |page, _| page.navigated));
+        assert!(!redraw_tooltip(cx));
+    }
+
+    #[gpui::test]
+    fn navigation_cancels_pending_tooltip_show(cx: &mut TestAppContext) {
+        let (page, cx) = tooltip_page(cx);
+        hover_tooltip(cx);
+        assert!(!redraw_tooltip(cx));
+        cx.simulate_keystrokes("ctrl-n");
+        assert!(page.read_with(cx, |page, _| page.navigated));
+        finish_tooltip_delay(cx);
+        assert!(!redraw_tooltip(cx));
+    }
+
+    #[gpui::test]
+    fn another_window_keystroke_keeps_this_windows_tooltip(cx: &mut TestAppContext) {
+        let (_, cx) = tooltip_page(cx);
+        hover_tooltip(cx);
+        finish_tooltip_delay(cx);
+        assert!(redraw_tooltip(cx));
+        let (_, other) = cx.cx.add_window_view(|window, cx| {
+            let view = cx.new(|_| TestView);
+            Root::new(view, window, cx).bordered(false)
+        });
+        other.simulate_keystrokes("a");
+        assert!(redraw_tooltip(cx));
+    }
