+/// An application-wide presentation for popup menus, installed as a global.
+///
+/// Without it, menus keep the upstream geometry and colors. With it, every
+/// dropdown, context menu and submenu shares one container and item recipe:
+/// checked items sit on a tonal container with a trailing check, pointer and
+/// keyboard highlight is a single state layer that leaves the text color
+/// alone, and the surface fades in when it opens.
+#[derive(Clone, Copy)]
+pub struct MenuStyle {
+    pub surface: Hsla,
+    pub radius: Pixels,
+    pub padding: Pixels,
+    pub item_height: AbsoluteLength,
+    pub item_radius: Pixels,
+    pub item_padding: AbsoluteLength,
+    pub gap: AbsoluteLength,
+    pub text_size: AbsoluteLength,
+    pub icon_size: AbsoluteLength,
+    pub icon_color: Hsla,
+    pub highlight: Hsla,
+    pub checked: Hsla,
+    /// Pointer or keyboard highlight on a checked row, over its tonal base.
+    pub checked_highlight: Hsla,
+    pub checked_foreground: Hsla,
+    pub danger: Hsla,
+    pub disabled: Hsla,
+    pub separator: Hsla,
+    /// The narrowest a menu gets; a caller's `min_w` can widen it.
+    pub min_width: Pixels,
+    /// Entrance length; reduced motion settles the menu on its first frame.
+    pub enter: Duration,
+}
+
