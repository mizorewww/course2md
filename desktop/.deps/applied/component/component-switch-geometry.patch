+    /// color, as in the Material 3 switch with icons.
+    pub fn thumb_icons(mut self, checked: impl Into<Icon>, unchecked: impl Into<Icon>) -> Self {
+        self.thumb_icons = Some((checked.into(), unchecked.into()));
+        self
+    }
