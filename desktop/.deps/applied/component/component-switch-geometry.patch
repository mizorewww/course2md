+        self
+    }
+
+    /// Use the 52 x 32 reference geometry with 24/16 px checked/unchecked thumbs.
+    /// An explicit track height scales every dimension from the 32 px baseline.
+    /// Other switches retain the component's original size and proportions.
+    pub fn reference_geometry(mut self) -> Self {
+        self.reference_geometry = true;
+        self
+    }
+
+    /// With `reference_geometry`: show an icon in the thumb for each state.
