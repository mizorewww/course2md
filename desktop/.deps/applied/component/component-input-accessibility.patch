+/// Byte boundaries for the text units the input engine can select. Each
+/// logical line is a separate run; CRLF is one selectable line break.
+fn accessibility_line_offsets(text: &str) -> Vec<Vec<usize>> {
+    let mut lines = vec![vec![0]];
+    let mut chars = text.char_indices().peekable();
+    while let Some((offset, ch)) = chars.next() {
+        let end = if ch == '\r' && chars.peek().is_some_and(|(_, ch)| *ch == '\n') {
+            chars.next().unwrap().0 + 1
+        } else {
+            offset + ch.len_utf8()
+        };
+        lines.last_mut().unwrap().push(end);
+        if text.as_bytes()[end - 1] == b'\n' {
+            lines.push(vec![end]);
+        }
+    }
+    lines
+}
+
+type AccessibleRuns = Vec<(gpui::accesskit::NodeId, Vec<usize>)>;
+
+fn accessibility_position(runs: &AccessibleRuns, offset: usize) -> gpui::accesskit::TextPosition {
+    let (node, offsets) = runs
+        .iter()
+        .find(|(_, offsets)| offset < *offsets.last().unwrap())
+        .unwrap_or_else(|| runs.last().unwrap());
+    let character_index = offsets
+        .partition_point(|boundary| *boundary <= offset)
+        .saturating_sub(1);
+    gpui::accesskit::TextPosition {
+        node: *node,
+        character_index,
+    }
+}
+
+fn accessibility_offset(
+    runs: &AccessibleRuns,
+    position: gpui::accesskit::TextPosition,
+) -> Option<usize> {
+    runs.iter()
+        .find(|(node, _)| *node == position.node)
+        .and_then(|(_, offsets)| offsets.get(position.character_index).copied())
+}
+
+fn write_accessibility_text(
+    builder: &mut gpui::A11ySubtreeBuilder,
+    text: &str,
+    selection: std::ops::Range<usize>,
+    cursor: usize,
+) -> AccessibleRuns {
+    let runs = accessibility_line_offsets(text)
+        .into_iter()
+        .enumerate()
+        .map(|(line, offsets)| {
+            let id = builder.synthetic_node_id(("input-text", line));
+            let mut node = gpui::accesskit::Node::new(Role::TextRun);
+            node.set_value(text[offsets[0]..*offsets.last().unwrap()].to_owned());
+            node.set_character_lengths(
+                offsets
+                    .windows(2)
+                    .map(|pair| (pair[1] - pair[0]) as u8)
+                    .collect::<Vec<_>>(),
+            );
+            builder.push_child(id, node);
+            (id, offsets)
+        })
+        .collect::<Vec<_>>();
+    let anchor = if cursor == selection.start {
+        selection.end
+    } else {
+        selection.start
+    };
+    builder
+        .parent_node()
+        .set_text_selection(gpui::accesskit::TextSelection {
+            anchor: accessibility_position(&runs, anchor),
+            focus: accessibility_position(&runs, cursor),
+        });
+    runs
+}
