{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Asia/Shanghai",
  "rebaseWhen": "conflicted",
  "commitBody": "Co-Authored-By: Renovate Bot <bot@renovateapp.com>",
  "gitIgnoredAuthors": [
    "41898282+claude[bot]@users.noreply.github.com"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The gpui-kit-material release whose tag every gpui-kit-material revision in Cargo.toml points at",
      "managerFilePatterns": [
        "/^Cargo\\.toml$/"
      ],
      "matchStrings": [
        "# gpui-kit-material release: (?<currentValue>material-v[0-9.]+)"
      ],
      "depNameTemplate": "gpui-kit-material",
      "packageNameTemplate": "https://github.com/mizorewww/gpui-kit-material",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "regex:^material-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Everything except the desktop's Material stack: detect and list on the Dependency Dashboard, open a PR only when ticked there, and merge it once CI passes",
      "matchDepNames": [
        "!gpui-kit-material"
      ],
      "dependencyDashboardApproval": true,
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Moved by the Material port (.github/upstream-port.md) to what gpui-kit-material requires",
      "matchDepNames": [
        "gpui-kit",
        "gpui-base",
        "gpui-kit-material-color",
        "gpui-material-symbols",
        "gpui-fast",
        "gpui-fast-*",
        "gpui-pre",
        "gpui-pre-*"
      ],
      "enabled": false
    },
    {
      "description": "The Git revisions themselves: the port moves them all to the release tag the marker names",
      "matchManagers": [
        "cargo"
      ],
      "matchDepNames": [
        "gpui-kit-material",
        "gpui-kit-material-color"
      ],
      "enabled": false
    },
    {
      "description": "gpui-kit-material releases: one PR on a fixed branch, which upstream-port.yml hands to Claude Code",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "gpui-kit-material"
      ],
      "branchTopic": "gpui-kit-material",
      "additionalBranchPrefix": "",
      "commitMessageTopic": "gpui-kit-material",
      "labels": [
        "upstream-sync"
      ],
      "automerge": false,
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "schedule": [
        "at any time"
      ],
      "prBodyNotes": [
        "The **Upstream port** workflow moves the desktop app to this release with Claude Code and pushes the result here. When every check passes it labels the PR `port-ready`; **Upstream land** then merges it once CI is green."
      ]
    }
  ]
}
